@model List<RaceDay.Mvc.ViewModels.EventApiResponse>

@{
    ViewData["Title"] = "My Events";
}

@section Styles {
    <link rel="stylesheet" href="~/css/event-management.css" asp-append-version="true" />
}

<div class="event-page">

    <div class="event-page-header">
        <div>
            <h2>My Events</h2>
            <p>Manage the race events you have created.</p>
        </div>

        <a asp-action="CreateEvent" class="event-button">
            Create New Event
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="event-alert success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="event-alert error">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="event-empty">
            <h3>No events found</h3>
            <p>You have not created any events yet.</p>

            <a asp-action="CreateEvent" class="event-button">
                Create Your First Event
            </a>
        </div>
    }
    else
    {
        <div class="event-table-container">

            <table class="event-table">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>@eventItem.EventName</td>
                            <td>@eventItem.Location</td>
                            <td>@eventItem.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@eventItem.Distance km</td>
                            <td>@(char.ToUpper(eventItem.EventType[0]) + eventItem.EventType.Substring(1))</td>
                            <td>@(char.ToUpper(eventItem.Status[0]) + eventItem.Status.Substring(1))</td>

                            <td class="event-actions">
                                <a asp-action="ManageCategories"
                                   asp-route-eventId="@eventItem.EventId"
                                   class="btn btn-info btn-action">
                                    <i class="fas fa-list"></i> 
                                    Categories
                                </a>

                                <a asp-action="EventEnrollments"
                                   asp-route-eventId="@eventItem.EventId"
                                   class="btn btn-check btn-action">
                                    <i class="fas fa-book"></i>
                                    Enrolments
                                </a>

                                <form asp-action="DeleteEvent"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');"
                                      style="display: inline;">

                                    <input type="hidden"
                                           name="eventId"
                                           value="@eventItem.EventId" />

                                    <a asp-action="EditEvent"
                                       asp-route-eventId="@eventItem.EventId"
                                       class="btn btn-primary btn-action">
                                        <i class="fas fa-edit"></i>
                                        Edit
                                    </a>

                                    <button type="submit" class="btn btn-danger btn-action">
                                        <i class="fas fa-trash"></i> 
                                        Delete
                                    </button>

                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }

</div>
