@model RaceDay.Mvc.ViewModels.EventEnrollmentViewModel

@{
    ViewData["Title"] = "Results Entry";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Results Entry</h2>
            <p class="text-muted">@Model.EventName</p>
        </div>

        <a asp-action="Events" class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Enrolled Participants</h5>

            @if (Model.Enrollments.Count == 0)
            {
                <div class="alert alert-info">
                    No participants have enrolled in this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Start Time</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrollment in Model.Enrollments)
                            {
                                <tr>
                                    <td>@enrollment.ParticipantName</td>
                                    <td>@enrollment.CategoryName</td>

                                    <form asp-action="RecordResult" method="post">

                                        <input type="hidden"
                                               name="eventId"
                                               value="@Model.EventId" />

                                        <input type="hidden"
                                               name="enrolmentId"
                                               value="@enrollment.EnrollmentId" />

                                        <td>
                                            <input type="datetime-local"
                                                   name="startTime"
                                                   class="form-control"
                                                   required />
                                        </td>

                                        <td>
                                            <input type="datetime-local"
                                                   name="finishTime"
                                                   class="form-control"
                                                   required />
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="position"
                                                   class="form-control"
                                                   min="1"
                                                   required />
                                        </td>

                                        <td>
                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">
                                                Save Result
                                            </button>
                                        </td>

                                    </form>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>