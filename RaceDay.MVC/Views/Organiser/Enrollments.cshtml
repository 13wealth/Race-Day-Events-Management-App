@model RaceDay.Mvc.ViewModels.OrganiserEnrollmentsViewModel

@{
    ViewData["Title"] = "Enrollments";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>All Enrollments</h2>
        <p class="text-muted">View and manage all participant enrollments across your events.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Enrollments" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label">Search Enrollments</label>
                        <input type="text"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search by participant name, event name, or category..." />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">
                Enrollment List
                <span class="badge bg-primary ms-2">@Model.Enrollments.Count</span>
            </h5>

            @if (Model.Enrollments.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    No enrollments found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Entry Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments)
                            {
                                <tr>
                                    <td>
                                        <strong>@enrollment.ParticipantName</strong>
                                        <br />
                                        <small class="text-muted">ID: @enrollment.ParticipantId</small>
                                    </td>
                                    <td>@enrollment.EventName</td>
                                    <td>
                                        <span class="badge bg-secondary">@enrollment.CategoryName</span>
                                    </td>
                                    <td>@enrollment.EntryDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (enrollment.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i> @enrollment.Status
                                            </span>
                                        }
                                        else if (enrollment.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock me-1"></i> @enrollment.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@enrollment.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
