@model RaceDay.Mvc.ViewModels.OrganiserDashboardViewModel

@section Styles {
    <link rel="stylesheet" 
          href="~/css/organiser-dashboard.css" 
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container-fluid py-4">

    <div class="dashboard-header">
        <h2>Organiser Dashboard</h2>
        <p>Overview of your race events and participant enrolments.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- Dashboard statistics -->
    <div class="row g-3">

        <div class="col-12 col-md-4">
            <div class="stat-card">
                <div class="stat-label">Total Events</div>
                <p class="stat-value">@Model.TotalEvents</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="stat-card">
                <div class="stat-label">Total Enrolments</div>
                <p class="stat-value">
                    @if (Model.EnrolmentDataAvailable)
                    {
                        @Model.TotalEnrolments
                    }
                    else
                    {
                        <span>Partial</span>
                    }
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="stat-card">
                <div class="stat-label">Upcoming Events</div>
                <p class="stat-value">@Model.UpcomingEvents</p>
            </div>
        </div>

    </div>

    <!-- Event overview -->
    <div class="dashboard-section">

        <h4>Your Events</h4>

        @if (Model.Events.Any())
        {
            <div class="table-responsive">
                <table class="table event-table align-middle">

                    <thead>
                        <tr>
                            <th>Banner</th>
                            <th>Event</th>
                            <th>Location</th>
                            <th>Date</th>
                            <th>Distance</th>
                            <th>Status</th>
                            <th>Enrolments</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var eventItem in Model.Events.OrderBy(e => e.EventDate))
                        {
                            <tr class="clickable-row" data-event-id="@eventItem.EventId" onclick="window.location.href='@Url.Action("EditEvent", "Organiser", new { eventId = eventItem.EventId })';" style="cursor: pointer;">
                                <td style="text-align: center; vertical-align: middle;">
                                    @if (!string.IsNullOrWhiteSpace(eventItem.BannerImageUrl))
                                    {
                                        <img src="@Url.Action("Banner", "Events", new { eventId = eventItem.EventId })" 
                                             alt="@eventItem.EventName banner" 
                                             style="height: 50px; width: auto; object-fit: contain; border-radius: 4px;" />
                                    }
                                    else
                                    {
                                        <span style="color: #999; font-size: 0.9rem;">No banner</span>
                                    }
                                </td>
                                <td>
                                    <strong>@eventItem.EventName</strong>
                                    <div class="text-muted small">
                                        @eventItem.EventType
                                    </div>
                                </td>

                                <td>@eventItem.Location</td>

                                <td>
                                    @eventItem.EventDate.ToString("dd MMM yyyy")
                                </td>

                                <td>@eventItem.Distance.ToString("0.##") km</td>

                                <td>
                                    <span class="status-badge">
                                        @eventItem.Status
                                    </span>
                                </td>

                                <td>
                                    @if (eventItem.EnrolmentCount.HasValue)
                                    {
                                        <strong>@eventItem.EnrolmentCount</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unavailable</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h5>No events yet</h5>
                <p>You haven't created any race events.</p>
            </div>
        }

    </div>

</div>