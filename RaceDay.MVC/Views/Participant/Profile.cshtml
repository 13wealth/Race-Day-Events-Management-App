@model RaceDay.Mvc.ViewModels.ParticipantProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <h2>My Profile</h2>
    <p>Manage your personal information and profile picture.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row mt-4">

        <!-- Personal Information -->
        <div class="col-md-8">
            <div class="card p-3">

                <h5>Personal Information</h5>

                <form asp-action="UpdateProfile" method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FirstName"
                               class="form-label">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName"
                               class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </form>

            </div>
        </div>

        <!-- Profile Picture Upload -->
        <div class="col-md-4">
            <div class="card p-3">

                <h5>Profile Picture</h5>

                <p class="text-muted">
                    Upload a new picture to update your profile.
                </p>

                <form asp-action="UploadProfileImage"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="ProfileImage"
                               class="form-label">
                            Choose Image
                        </label>

                        <input asp-for="ProfileImage"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Upload Picture
                    </button>

                </form>

            </div>
        </div>

    </div>

</div>
