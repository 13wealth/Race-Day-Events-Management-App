@model RaceDay.Mvc.ViewModels.ParticipantMyEventsViewModel

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <h2>My Events</h2>
    <p class="text-muted">View the races you have enrolled in.</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Enrollments.Count == 0)
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>

        <a asp-action="UpcomingEvents" class="btn btn-primary">
            Browse Upcoming Events
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover clickable-table">

                <thead class="table-dark">
                    <tr>
                        <th>Banner</th>
                        <th>Event</th>
                        <th>Location</th>
                        <th>Event Date</th>
                        <th>Category</th>
                        <th>Entry Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Enrollments)
                    {
                        <tr class="clickable-row" data-event-id="@item.EventId" data-url="@Url.Action("EventDetails", "Participant", new { eventId = item.EventId })" style="cursor: pointer;" onclick="navigateToEvent(this)">
                            <td style="pointer-events: auto; cursor: pointer; text-align: center; vertical-align: middle;">
                                @if (!string.IsNullOrWhiteSpace(item.BannerImageUrl))
                                {
                                    <img src="@Url.Action("Banner", "Events", new { eventId = item.EventId })" 
                                         alt="@item.EventName banner" 
                                         style="height: 60px; width: auto; object-fit: contain; border-radius: 4px;" />
                                }
                                else
                                {
                                    <span style="color: #999; font-size: 0.9rem;">No banner</span>
                                }
                            </td>
                            <td style="pointer-events: auto; cursor: pointer;">@item.EventName</td>
                            <td style="pointer-events: auto; cursor: pointer;">@item.Location</td>
                            <td style="pointer-events: auto; cursor: pointer;">@item.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td style="pointer-events: auto; cursor: pointer;">@item.CategoryName</td>
                            <td style="pointer-events: auto; cursor: pointer;">@item.EntryDate.ToString("dd MMM yyyy")</td>
                            <td style="pointer-events: auto; cursor: pointer;" onclick="event.stopPropagation(); navigateToEvent(this.parentElement);">
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <style>
            /* Custom table striping that doesn't interfere with click events */
            .clickable-table tbody tr:nth-child(odd) {
                background-color: #f9fafb;
            }

            .clickable-table tbody tr:nth-child(even) {
                background-color: #ffffff;
            }

            .clickable-table tbody tr {
                cursor: pointer;
                pointer-events: auto;
                user-select: none;
            }

            .clickable-table tbody tr:hover {
                background-color: #e8f0ff !important;
            }

            .clickable-table tbody tr td {
                pointer-events: auto;
                cursor: pointer;
            }
        </style>

        <script>
            function navigateToEvent(rowElement) {
                const url = rowElement.getAttribute('data-url');
                const eventId = rowElement.getAttribute('data-event-id');
                console.log('Navigating to event: ' + eventId + ' with URL: ' + url);
                if (url) {
                    window.location.href = url;
                } else if (eventId) {
                    window.location.href = '@Url.Action("EventDetails", "Participant", new { eventId = "EVENTID" })'.replace('EVENTID', eventId);
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                const clickableRows = document.querySelectorAll('table tbody tr.clickable-row');
                console.log('Found ' + clickableRows.length + ' clickable rows in the table');

                clickableRows.forEach(function (row, index) {
                    const eventId = row.getAttribute('data-event-id');
                    const url = row.getAttribute('data-url');
                    console.log('Row ' + (index + 1) + ': eventId = ' + eventId + ', url = ' + url);

                    // Ensure all cells are clickable and point to the row
                    const cells = row.querySelectorAll('td');
                    cells.forEach(function (cell) {
                        cell.style.pointerEvents = 'auto';
                        cell.style.cursor = 'pointer';

                        // Add click handler to each cell that doesn't have onclick already
                        if (!cell.onclick) {
                            cell.addEventListener('click', function (e) {
                                e.stopPropagation();
                                navigateToEvent(row);
                            });
                        }
                    });
                });
            });
        </script>
    }

</div>